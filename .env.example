# Copy to .env and fill in. Never commit .env.
# Optional journey statistics database path (default: db/journey_stats.sqlite in the repo).
# JOURNEY_STATS_DB=/absolute/path/to/journey_stats.sqlite
# dane.um.warszawa.pl portal key (header "Authorization: <key>")
PORTAL_KEY=
# api.um.warszawa.pl key
WAW_API_KEY=
# PKP PLK key (optional)
PLK_KEY=
# Live bus positions used by bus detection (optional). When set, this URL is polled over HTTP;
# when empty, the server reads the City Hall feed directly with PORTAL_KEY.
LIVE_BUSES_URL=http://localhost:8000/api/live/vehicles?type=bus
# Radius (m) for the delay estimate: a vehicle passed a stop when it was this close (optional, default 80)
DELAY_RADIUS_M=80
