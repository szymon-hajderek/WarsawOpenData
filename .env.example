# Copy to .env and fill in. Never commit .env.
# dane.um.warszawa.pl portal key (header "Authorization: <key>")
PORTAL_KEY=
# api.um.warszawa.pl key
WAW_API_KEY=
# PKP PLK key (optional)
PLK_KEY=
# Live bus positions used by bus detection (optional, default: our own backend)
LIVE_BUSES_URL=http://localhost:8000/api/live/vehicles?type=bus
# Radius (m) for the delay estimate: a vehicle passed a stop when it was this close (optional, default 30)
DELAY_RADIUS_M=30
